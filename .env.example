# ConceptLens — environment variables
# Copy to .env and fill in real values for local development.

# Database (used by both app and Alembic)
CONCEPTLENS_DATABASE_URL=postgresql+asyncpg://conceptlens:conceptlens@localhost:55432/conceptlens

# File storage directory (relative to backend/ or absolute)
CONCEPTLENS_UPLOAD_DIR=../storage/uploads

# Debug mode (enables SQLAlchemy echo, etc.)
CONCEPTLENS_DEBUG=false

# Video processing
CONCEPTLENS_VIDEO_TRANSCRIPTION_MODEL=mlx-community/whisper-base-mlx
CONCEPTLENS_VIDEO_MAX_FRAMES=15
CONCEPTLENS_VIDEO_MIN_FRAME_GAP_SECONDS=2.0
CONCEPTLENS_VIDEO_SUBPROCESS_TIMEOUT_SECONDS=300
CONCEPTLENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CONCEPTLENS_EMBEDDING_DIMENSIONS=384
CONCEPTLENS_EMBEDDING_BATCH_SIZE=32

# OpenAI-compatible chat/completions provider (server-side only).
# Set all three to enable Ask, assessments, semantic grading and guided learning.
CONCEPTLENS_LLM_BASE_URL=
CONCEPTLENS_LLM_API_KEY=
CONCEPTLENS_LLM_MODEL=
CONCEPTLENS_LLM_TIMEOUT_SECONDS=45
# Image-capable model on the same endpoint; required for visual interpretation.
CONCEPTLENS_VISION_MODEL=
